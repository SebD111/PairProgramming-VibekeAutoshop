@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vibekes Autoshop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-navbar">
        <div class="site-container navbar-inner">
            <a class="brand" href="~/">Vibekes Autoshop</a>
            <ul class="nav-links">
                <li><a href="~/">Forside</a></li>
                <li><a href="~/Cars">Biler</a></li>
            </ul>
        </div>
    </header>

    <div class="site-container">
        <main role="main" class="content">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-container">
            &copy; @DateTime.Now.Year Vibekes Autoshop
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

